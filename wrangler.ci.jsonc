{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-manager",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "vars": {
    "GOOGLE_CLIENT_ID": "297970704704-m05hgt93lfaq286q90br8c96ffg1aph3.apps.googleusercontent.com",
    "ADMIN_CODE": "QA-ADMIN-CI",
    // AREA G2 (owner D8): Tier A admin-recovery email OTP. Default false;
    // tools/qa-admin-recovery.cjs overrides to true with --var + points
    // RESEND_API_BASE at its local mock mail server (captures the real
    // email body to extract the OTP — no echo seam).
    "EMAIL_RECOVERY_ENABLED": false
  },
  // CI-only: stripped AI, Vectorize, and service bindings that cause
  // infinite reload loops in local wrangler dev.
  // RATE_LIMITER binding omitted — in-memory fallback (max:30/min/key)
  // resets on each wrangler restart, avoiding cross-phase rate-limit
  // accumulation that causes false 429s in the email-auth test.
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1-presence", "new_sqlite_classes": ["Presence"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-manager-db",
      "database_id": "bd19fcdf-736e-4ce9-afba-5a8e8f5aa16c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "my-manager-state"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "c1d3fa573457452699af2dab30979e9c" }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "mmgr-events" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
